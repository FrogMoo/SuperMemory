# dependencies
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Obsidian machine-specific state
.obsidian/workspace.json

# third-party app data that leaked into this directory (Sogou IME etc.)
sgim_*.bin
inputstat.dat
image.*.db
share.config
user.config
Backup/
%SystemDrive%/

# transient dev-iteration builds (scripts/dev-load.sh)
lib/dev-*.js
.probe/

# plugin runtime state (auto-generated task skills / archive / cleanup journal)
.dsh/skills/
.dsh/skills-archive/
.dsh/capabilities/
.dsh/capabilities-archive/
.dsh/r48-delayed-cleanup-*.json

# release binaries are uploaded as Release assets, not committed (scripts/package-release.mjs)
release/dsh-supermemory-*/
release/*.zip
release/*.tgz
release/*.tar.gz
