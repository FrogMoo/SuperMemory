{
  "name": "dsh-supermemory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/supermemory.js",
  "exports": {
    ".": "./lib/supermemory.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "cordis": ">=4.0.0-rc <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build:host": "tsdown",
    "build:client": "tsdown -c tsdown.client.config.ts && node scripts/wrap-client.mjs",
    "smoke:webui": "node scripts/webui-smoke.mjs",
    "smoke:core": "node scripts/core-smoke.mjs",
    "smoke": "node scripts/core-smoke.mjs && node scripts/webui-smoke.mjs && node scripts/client-sim-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
