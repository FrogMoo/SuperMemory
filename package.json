{
  "name": "dsh-supermemory",
  "version": "1.3.1",
  "description": "SuperMemory — DSH 跨会话记忆插件：话题集记忆、派发归档、过程内再召回与统一能力（知识面 SKILL.md + 执行面 sm_cap_*）。",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/supermemory.js",
  "exports": {
    ".": "./lib/supermemory.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "cordis": ">=4.0.0-rc <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "git:sync": "node scripts/git-sync-push.mjs",
    "install:dsh": "node scripts/install-into-dsh.mjs",
    "build": "tsdown && tsdown -c tsdown.client.config.ts && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build:host": "tsdown",
    "build:client": "tsdown -c tsdown.client.config.ts && node scripts/wrap-client.mjs",
    "smoke:webui": "node scripts/webui-smoke.mjs",
    "smoke:core": "node scripts/core-smoke.mjs",
    "smoke:skill": "node scripts/skill-smoke.mjs",
    "skill:cleanup": "node --experimental-transform-types scripts/skill-cleanup.mjs",
    "smoke": "node scripts/core-smoke.mjs && node scripts/mechanism-smoke.mjs && node scripts/webui-smoke.mjs && node scripts/client-sim-smoke.mjs && node scripts/capability-smoke.mjs && node scripts/workspace-scope-smoke.mjs && node scripts/skill-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
